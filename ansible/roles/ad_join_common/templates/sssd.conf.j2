# Managed by pmx — do not edit by hand.
[sssd]
domains = {{ ad_domain }}
config_file_version = 2
services = nss, pam
# Global option (SPECIAL SECTIONS in sssd.conf(5)); silently ignored inside a
# [domain/...] section, which is where it sat until 2026-09-12. With it here,
# "domain admins" is presented by NSS as "domain_admins".
override_space = _

[domain/{{ ad_domain }}]
id_provider = ad
access_provider = simple
ad_domain = {{ ad_domain }}
krb5_realm = {{ ad_realm }}
realmd_tags = manages-system joined-with-adcli
cache_credentials = True
krb5_store_password_if_offline = True
ldap_id_mapping = True
use_fully_qualified_names = False
default_shell = {{ sssd_default_shell }}
fallback_homedir = {{ sssd_fallback_homedir }}
simple_allow_groups = {{ sssd_simple_allow_groups | join(', ') }}
{% if sssd_dyndns_update | default(false) %}
# Self-maintain this host's AD DNS records via secure GSS-TSIG dynamic updates,
# using the machine's own Kerberos credentials. Pairs with `pmx destroy`, which
# deregisters these on teardown.
dyndns_update = true
dyndns_update_ptr = {{ 'true' if (sssd_dyndns_update_ptr | default(true)) else 'false' }}
dyndns_refresh_interval = {{ sssd_dyndns_refresh_interval | default(43200) }}
dyndns_auth = gss-tsig
{% endif %}
